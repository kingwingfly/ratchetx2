# Build from the repository root, since the server uses the workspace's crates:
# podman build -f e2ee_chat_server/Containerfile --target server -t e2ee_chat_server .
FROM docker.io/rust:1.99-alpine AS server-builder

RUN apk update \
    && apk add --no-cache --purge musl-dev

WORKDIR /build

COPY . .

RUN cargo build --release --locked -p e2ee_chat_server

########################################

FROM docker.io/alpine:latest AS server

WORKDIR /app

RUN apk update \
    && apk add --no-cache --purge bash

COPY --from=server-builder /build/target/release/e2ee_chat_server .

STOPSIGNAL SIGINT
EXPOSE 443

ENTRYPOINT ["./e2ee_chat_server"]
